{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**",
      "excludeFiles": "{*.md,docs/**,.env*,frontend/**,backend/tests/**,backend/.venv/**,backend/.pytest_cache/**,backend/uv.lock,backend/Dockerfile,backend/.dockerignore,docker-compose.yml,scripts/**,.vercel/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
